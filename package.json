    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@types/react": "^18.2.46",
    "@types/react-dom": "^18.2.18",
    "nanoid": "^3.3.7",
    "typescript": "^5.3.3"
  },
  "overrides": {
    "@cesium/engine": "4.0.0",
